# smartclass-dispatchub configuration.
#
# Copy to .env (or any file) and point DISPATCH_ENV_FILE at it; the process
# reads the file only when that variable is set. Real environment variables
# always win over file values, and file values win over the defaults below.
# Never commit a filled-in copy: DISPATCH_DSN and every *_SECRET are secrets.

# Trigger: path of a .env-style file loaded at startup. Unset by default.
# DISPATCH_ENV_FILE=/etc/dispatchub/dispatchub.env

# HTTP listen address. Default: :8081
DISPATCH_LISTEN_ADDR=:8081

# PostgreSQL DSN (required). The pool sets application_name=smartclass-dispatchub.
DISPATCH_DSN=postgres://dispatchub:change-me@127.0.0.1:5432/dispatchub?sslmode=disable

# Timezone used to turn (date, period) into instants. Default: Asia/Shanghai
DISPATCH_TIMEZONE=Asia/Shanghai

# teamusers base URL; JWKS is discovered at {url}/.well-known/jwks.json.
# Required unless DISPATCH_DEV=true.
DISPATCH_TEAMUSERS_URL=http://127.0.0.1:8082

# Expected JWT issuer claim. Default: teamusers
DISPATCH_TEAMUSERS_ISSUER=teamusers

# Expected JWT audience claim. Default: teamusers
# Set it to the fleet value (TEAMUSERS_TOKEN_AUDIENCE, e.g. nekostick).
DISPATCH_TEAMUSERS_AUD=teamusers

# teamusers client-credentials credential (required): used for outbound calls
# to webcam-server and for remote permission lookups. Both must be set.
DISPATCH_TEAMUSERS_CLIENT_ID=dispatchub-svc
DISPATCH_TEAMUSERS_CLIENT_SECRET=change-me

# IAM HTTP timeout. Default: 5s
DISPATCH_TEAMUSERS_TIMEOUT=5s

# webcam-server base URL, e.g. http://webcam:8080. Required unless DISPATCH_DEV=true.
DISPATCH_WEBCAM_URL=http://127.0.0.1:8080

# Outbound HTTP timeout for webcam-server calls. Default: 10s
DISPATCH_WEBCAM_TIMEOUT=10s

# Scheduler scan interval. Default: 30s
DISPATCH_SCHED_TICK=30s

# How early a session's recording starts. Default: 2m
DISPATCH_PRESTART=2m

# Delay before stopping at ends_at. Default: 0s
DISPATCH_POSTSTOP_GRACE=0s

# Start attempts before a session is marked failed. Default: 3
DISPATCH_START_RETRY_MAX=3

# Past starts_at + grace a planned session becomes missed. Default: 10m
DISPATCH_MISS_GRACE=10m

# Photo-id resolution poll interval. Default: 2s
DISPATCH_PHOTO_POLL_INTERVAL=2s

# Give up on a photo (status unresolved) after this. Default: 15m
DISPATCH_PHOTO_POLL_TTL=15m

# Outbound command concurrency cap. Default: 8
DISPATCH_MAX_CONCURRENT_COMMANDS=8

# CSV row cap per import. Default: 5000
DISPATCH_MAX_IMPORT_ROWS=5000

# Dev bypass: synthetic claims, teamusers disabled. Default: false
# Local development only; never enable it on a reachable host.
DISPATCH_DEV=false

# slog level: debug | info | warn | error. Default: info
DISPATCH_LOG_LEVEL=info
